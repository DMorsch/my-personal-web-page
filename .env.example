# Copy this file to `.env` (untracked) and fill in real values before running
# `docker compose up --build`.

# Password for the `backend` Postgres role, shared by the db and backend services.
POSTGRES_PASSWORD=backend

# Contents of backend/config/master.key — required for Rails to boot in
# production (decrypts config/credentials.yml.enc).
RAILS_MASTER_KEY=
